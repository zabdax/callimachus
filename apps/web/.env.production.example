# Production env — copy to .env.production (gitignored) and fill in real values,
# OR set these as GitHub Actions secrets and inject at build time via
# `.github/workflows/deploy.yml`.
#
# None of these values should EVER be committed to git.

# Supabase (public anon key + URL; the service_role key lives only in the
# Worker as SUPABASE_SERVICE_KEY and is never exposed here).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry (browser SDK). Source maps uploaded via @sentry/vite-plugin.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Browser API base (normally the deployed Cloudflare Worker origin).
VITE_WORKERS_BASE=https://hsc-tracker-ef2b5-workers.byzubooo.workers.dev

# MUST be false in production. The /__test/timer route leaks the timer
# without auth — only mounted when this is "true" (dev/CI only).
VITE_ENABLE_TEST_ROUTES=false

# Mock uid for the dev timer-persistence e2e spec (no-op in production
# because VITE_ENABLE_TEST_ROUTES is false).
VITE_E2E_UID=e2e-mock-uid
