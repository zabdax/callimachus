    "idb": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^6.30.4",
    "zod": "^3.25.76"
