{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAll",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::hsc-tracker-screenshots",
        "arn:aws:s3:::hsc-tracker-screenshots/*"
      ]
    },
    {
      "Sid": "OwnerReadPaymentScreenshots",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::hsc-tracker-screenshots/paymentRequests/*",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "paymentRequests/${jwt:sub}/",
            "paymentRequests/${jwt:sub}/*"
          ]
        }
      }
    },
    {
      "Sid": "OwnerPutPaymentScreenshot",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::hsc-tracker-screenshots/paymentRequests/*",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "paymentRequests/${jwt:sub}/",
            "paymentRequests/${jwt:sub}/*"
          ],
          "s3:content-type": [
            "image/*"
          ]
        }
      }
    }
  ]
}