// storage.rules — kept as an OPTIONAL alternative for anyone who prefers
// Firebase Storage over Cloudflare R2.
//
// v1.0 used Firebase Storage + signed-URL upload. v2.0 (Plan 4) migrates
// to Cloudflare R2; the bucket policy that replaces this file lives at
// /r2-bucket-policy.json. Both options enforce the same constraints:
//
//   - Deny by default.
//   - Allow owner-scoped reads on paymentRequests/{uid}/*.
//   - Allow owner-scoped PUT only with image/* content type.
//
// To use this Firebase Storage config instead of R2, also uncomment
// the `storage` block in /firebase.json and revert
// /apps/workers/src/handlers/generateSignedUploadUrl.ts to call
// `admin.storage().bucket().file(path).getSignedUrl(...)`.
//
// This file is NOT deployed by the default v2.0 pipeline. The deploy
// script (`scripts/deploy.mjs`) ignores it; deploy-r2.mjs applies
// /r2-bucket-policy.json instead.

rules_version = '2';
service firebase.storage {
  match /{path=**} {
    allow read, write: if false;
  }

  // Payment screenshot uploads. Uploads are performed via a signed URL
  // minted by the `generateSignedUploadUrl` Cloud Function, which sets the
  // content type to image/* and writes the object to
  // paymentRequests/{uid}/{uuid}.{ext}. Owners can read their own files.
  match /paymentRequests/{uid}/{file} {
    allow read: if request.auth != null && request.auth.uid == uid;
    allow write: if request.auth != null
      && request.auth.uid == uid
      && request.resource.size < 5 * 1024 * 1024
      && request.resource.contentType.matches('image/.*');
  }
}